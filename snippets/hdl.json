{
  "Module": {
    "prefix": "module",
    "description": "Module with ports",
    "body": [
      "module ${1:${TM_FILENAME_BASE}} #(",
      "  parameter int ${2:WIDTH} = ${3:8}",
      ") (",
      "  input  wire             clk,",
      "  input  wire             rst_n,",
      "  input  wire [$2-1:0]    ${4:din},",
      "  output reg  [$2-1:0]    ${5:dout}",
      ");",
      "",
      "  $0",
      "",
      "endmodule"
    ]
  },
  "Always posedge (async reset)": {
    "prefix": "alwaysff",
    "description": "Clocked always block with active-low async reset",
    "body": [
      "always @(posedge ${1:clk} or negedge ${2:rst_n}) begin",
      "  if (!$2) begin",
      "    ${3:q} <= ${4:'0};",
      "  end else begin",
      "    $3 <= ${5:d};",
      "  end",
      "end"
    ]
  },
  "Always combinational": {
    "prefix": "alwayscomb",
    "body": ["always @(*) begin", "  $0", "end"]
  },
  "FSM (Verilog, localparam, two-process)": {
    "prefix": "fsmv",
    "description": "Verilog-2001 state machine using localparams (detected by the 10xEngineers EDA FSM viewer)",
    "body": [
      "localparam [1:0] ${1:IDLE} = 2'd0,",
      "                 ${2:RUN}  = 2'd1,",
      "                 ${3:DONE} = 2'd2;",
      "",
      "reg [1:0] state, next_state;",
      "",
      "always @(posedge ${4:clk} or negedge ${5:rst_n}) begin",
      "  if (!$5) state <= $1;",
      "  else     state <= next_state;",
      "end",
      "",
      "always @(*) begin",
      "  next_state = state;",
      "  case (state)",
      "    $1:  if (${6:start}) next_state = $2;",
      "    $2:  if (${7:finish}) next_state = $3;",
      "    $3:  next_state = $1;",
      "    default: next_state = $1;",
      "  endcase",
      "end",
      "$0"
    ]
  },
  "Case statement": {
    "prefix": "case",
    "body": ["case (${1:sel})", "  ${2:2'b00}: $3", "  default: $4", "endcase"]
  },
  "If / else": {
    "prefix": "ifelse",
    "body": ["if (${1:cond}) begin", "  $2", "end else begin", "  $3", "end"]
  },
  "Begin / end": {
    "prefix": "begin",
    "body": ["begin", "  $0", "end"]
  },
  "Generate for": {
    "prefix": "genfor",
    "body": [
      "genvar ${1:i};",
      "generate",
      "  for ($1 = 0; $1 < ${2:N}; $1 = $1 + 1) begin : ${3:g_loop}",
      "    $0",
      "  end",
      "endgenerate"
    ]
  },
  "Instance": {
    "prefix": "inst",
    "body": ["${1:module_name} ${2:u_$1} (", "  .${3:clk}  (${4:clk}),", "  .${5:rst_n}(${6:rst_n})$0", ");"]
  },
  "Clock generator": {
    "prefix": "clkgen",
    "body": ["initial ${1:clk} = 1'b0;", "always #${2:5} $1 = ~$1;"]
  },
  "Dump VCD for 10xEngineers EDA": {
    "prefix": "dumpvcd",
    "description": "Dump a VCD waveform that opens in the 10xEngineers EDA waveform viewer",
    "body": [
      "initial begin",
      "  \\$dumpfile(\"${1:waves}.vcd\");",
      "  \\$dumpvars(0, ${2:${TM_FILENAME_BASE}});",
      "end"
    ]
  },
  "Testbench": {
    "prefix": "tb",
    "description": "Self-contained testbench with clock, reset and VCD dump",
    "body": [
      "`timescale 1ns/1ps",
      "module tb_${1:dut};",
      "  reg clk = 1'b0;",
      "  reg rst_n = 1'b0;",
      "  always #5 clk = ~clk;",
      "",
      "  $1 u_$1 (",
      "    .clk  (clk),",
      "    .rst_n(rst_n)",
      "  );",
      "",
      "  initial begin",
      "    \\$dumpfile(\"tb_$1.vcd\");",
      "    \\$dumpvars(0, tb_$1);",
      "    repeat (3) @(posedge clk);",
      "    rst_n = 1'b1;",
      "    $0",
      "    repeat (100) @(posedge clk);",
      "    \\$finish;",
      "  end",
      "endmodule"
    ]
  },
  "Display": {
    "prefix": "display",
    "body": ["\\$display(\"%0t: ${1:msg} %0d\", \\$time, ${2:var});"]
  },
  "Include guard": {
    "prefix": "guard",
    "body": ["`ifndef ${1:${TM_FILENAME_BASE/(.*)/${1:/upcase}/}_SVH}", "`define $1", "", "$0", "", "`endif // $1"]
  },
  "Task": {
    "prefix": "task",
    "body": ["task ${1:name}(input ${2:int} ${3:arg});", "  $0", "endtask"]
  },
  "Function": {
    "prefix": "function",
    "body": ["function ${1:[7:0]} ${2:name}(input ${3:[7:0]} ${4:a});", "  $2 = $0;", "endfunction"]
  }
}
