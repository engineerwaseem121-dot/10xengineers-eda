{
  "comments": { "lineComment": "#", "blockComment": ["/*", "*/"] },
  "brackets": [["(", ")"], ["[", "]"], ["{", "}"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "/*", "close": " */", "notIn": ["string"] }
  ],
  "surroundingPairs": [["(", ")"], ["[", "]"], ["{", "}"], ["\"", "\""], ["'", "'"]],
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([%.]?[A-Za-z_][\\w.]*)|(-?\\d+)",
  "folding": { "markers": { "start": "^\\s*\\.(macro|rept|if\\w*)\\b", "end": "^\\s*\\.(endm|endr|endif)\\b" } }
}
